{
  "name": "eye-face",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "look": "vite build --config vite.looks.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "shot": "node tools/shot.mjs",
    "site:dev": "(test -d ../site/node_modules || npm --prefix ../site ci) && npm --prefix ../site run dev",
    "site:build": "(test -d ../site/node_modules || npm --prefix ../site ci) && npm --prefix ../site run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@fontsource/doto": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
